CI_ENVIRONMENT=development
APP_NAME="iCARE"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8080
FRONTEND_URL=http://localhost:8080
APP_TIMEZONE=Asia/Manila
# New installation: php spark icare:key. Existing installation: keep its APP_KEY.
APP_KEY=

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=icare_ci
DB_USERNAME=root
DB_PASSWORD=
# Optional verified TLS for a remote MySQL server:
MYSQL_ATTR_SSL_CA=
MYSQL_ATTR_SSL_VERIFY=true

CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
# Log transport for initial local setup. Switch to smtp for actual email delivery.
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=
MAIL_FROM_ADDRESS=icare@example.edu
MAIL_FROM_NAME=iCARE
# Optional: cloudinary://api_key:api_secret@cloud_name
CLOUDINARY_URL=

# Blank uses the same origin. For a separate frontend, set the API origin and rebuild.
VITE_API_URL=
VITE_APP_NAME=iCARE
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:5173
TOKEN_EXPIRATION=480
# Existing SANCTUM_EXPIRATION is also accepted as a migration fallback.
CRON_SECRET=
# Enable only after verifying SMTP delivery.
AUTH_OTP_ENABLED=false
DEV_TOOLS_ENABLED=false
STAFF_EMAIL_DOMAINS=
