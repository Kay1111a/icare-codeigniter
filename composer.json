{
    "name": "icare/codeigniter",
    "description": "iCARE CodeIgniter 4 API and Vue 3 portal, with standalone Illuminate data and messaging components.",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "ext-intl": "*",
        "ext-mbstring": "*",
        "ext-pdo": "*",
        "codeigniter4/framework": "^4.7",
        "doctrine/dbal": "^3.10",
        "dompdf/dompdf": "^3.1",
        "guzzlehttp/guzzle": "^7.9",
        "illuminate/auth": "^12.0",
        "illuminate/cache": "^12.0",
        "illuminate/config": "^12.0",
        "illuminate/console": "^12.0",
        "illuminate/container": "^12.0",
        "illuminate/database": "^12.0",
        "illuminate/encryption": "^12.0",
        "illuminate/events": "^12.0",
        "illuminate/filesystem": "^12.0",
        "illuminate/hashing": "^12.0",
        "illuminate/http": "^12.0",
        "illuminate/mail": "^12.0",
        "illuminate/notifications": "^12.0",
        "illuminate/pagination": "^12.0",
        "illuminate/queue": "^12.0",
        "illuminate/support": "^12.0",
        "illuminate/translation": "^12.0",
        "illuminate/validation": "^12.0",
        "illuminate/view": "^12.0",
        "league/flysystem-local": "^3.0",
        "monolog/monolog": "^3.0",
        "phpoffice/phpspreadsheet": "^5.9",
        "symfony/http-kernel": "^7.3",
        "vlucas/phpdotenv": "^5.6"
    },
    "require-dev": {
        "fakerphp/faker": "^1.24",
        "mockery/mockery": "^1.6",
        "phpunit/phpunit": "^10.5",
        "illuminate/testing": "^12.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Config\\": "app/Config/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        },
        "files": [
            "app/Libraries/Bridge/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {}
    }
}
